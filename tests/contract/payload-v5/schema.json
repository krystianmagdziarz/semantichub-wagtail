{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantichub.app/contracts/payload-v5.schema.json",
  "title": "SemanticHub payload v5",
  "description": "Payload dostawy wyniku (kanał http i kolejka wtyczki). Źródło prawdy: backend/app/services/result_payload.py::compose_payload. Odbiornik ignoruje nieznane klucze (F2), dlatego additionalProperties zostaje dozwolone wszędzie. Opis funkcji odbiornika: docs/system/10-receivers.md.",
  "type": "object",
  "required": [
    "payload_version", "mode", "event", "workflow_execution", "workflow_name",
    "title", "lead", "executed_at", "articles_count", "articles", "clusters",
    "llm_response", "ai_model", "tokens_used", "cost",
    "result_id", "revision", "published_at", "source_lang", "pair_source_lang", "steps"
  ],
  "properties": {
    "payload_version": { "const": 5 },
    "mode": { "enum": ["article", "cluster"] },
    "event": { "enum": ["workflow.action", "cluster.updated"] },
    "workflow_execution": { "type": "string", "minLength": 1 },
    "workflow_name": { "type": "string" },
    "title": { "type": ["string", "null"] },
    "lead": { "type": ["string", "null"] },
    "executed_at": { "$ref": "#/$defs/timestamp" },
    "published_at": { "$ref": "#/$defs/timestamp" },
    "articles_count": { "type": "integer", "minimum": 0 },
    "articles": { "type": "array", "items": { "$ref": "#/$defs/article" } },
    "clusters": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/cluster" } },
    "llm_response": { "type": ["string", "null"] },
    "ai_model": { "type": ["string", "null"] },
    "tokens_used": { "type": "integer", "minimum": 0 },
    "cost": { "type": "number", "minimum": 0 },
    "result_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "source_lang": { "$ref": "#/$defs/lang" },
    "pair_source_lang": { "$ref": "#/$defs/lang" },
    "steps": { "type": "object", "maxProperties": 0, "description": "Zawsze puste od 2026-09-29: wyjścia pośrednie kroków nie wychodzą do odbiorcy. Klucz zostaje dla zgodności." },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } },
    "image": { "$ref": "#/$defs/image" },
    "tags": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1 } },
    "publish_mode": { "enum": ["moderation", "draft", "publish"] },
    "fields": { "type": "object", "minProperties": 1 },
    "locales": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/lang" },
      "additionalProperties": { "$ref": "#/$defs/locale" }
    },
    "parent_execution": { "type": "string", "minLength": 1 },
    "new_articles": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "article" } } },
      "then": {
        "required": ["locales"],
        "properties": { "llm_response": { "type": "string", "minLength": 1 } }
      },
      "else": {
        "properties": {
          "llm_response": { "type": "null" }
        },
        "not": { "anyOf": [{ "required": ["locales"] }, { "required": ["sections"] }] }
      }
    },
    {
      "if": { "properties": { "revision": { "minimum": 2 } } },
      "then": {
        "required": ["parent_execution", "new_articles"],
        "properties": { "event": { "const": "cluster.updated" } }
      },
      "else": {
        "properties": { "event": { "const": "workflow.action" } },
        "not": { "anyOf": [{ "required": ["parent_execution"] }, { "required": ["new_articles"] }] }
      }
    }
  ],
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "lang": { "enum": ["pl", "en"] },
    "article": {
      "type": "object",
      "required": ["id", "title", "url"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "portal_name": { "type": "string" },
        "author": { "type": ["string", "null"] },
        "published_date": { "type": ["string", "null"] },
        "lead": { "type": ["string", "null"] },
        "content": { "type": ["string", "null"] },
        "main_image_url": { "type": ["string", "null"] }
      }
    },
    "cluster": {
      "type": "object",
      "required": ["id", "goal_id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "goal_id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "semantic_groups": { "type": "object" }
      }
    },
    "locale": {
      "type": "object",
      "required": ["title", "slug", "lead", "body", "body_html", "seo_description"],
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "lead": { "type": "string" },
        "body": { "type": "string" },
        "body_html": { "type": "string" },
        "seo_description": { "type": "string" }
      }
    },
    "image": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "alt": { "type": "string" },
        "credit": { "type": "string" }
      }
    },
    "block": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {
          "enum": [
            "core/paragraph", "core/heading", "core/image", "core/list", "core/quote",
            "core/table", "core/embed", "core/separator", "sh/section"
          ]
        },
        "data": { "type": "object" }
      }
    },
    "section": {
      "type": "object",
      "required": ["key", "blocks", "status"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "data": {},
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "status": { "type": "string" },
        "inlined": { "const": true }
      }
    }
  }
}
